Gitignore · TXT
# ============================================================
#  wildtag.ai .gitignore
#  Keeps multi-GB runtime, model weights, and build output out
#  of git. Track only source code and small config/reference files.
# ============================================================
 
# --- Python runtimes (huge, machine-specific, rebuilt by setup) ---
wildtag_env/
validate_env/
 
# --- Model weights (large binaries; distributed separately) ---
models/
# wt_models/ is SOURCE code and IS tracked, but not any weight files
# that might land inside it:
wt_models/**/*.pt
wt_models/**/*.pth
wt_models/**/*.onnx
wt_models/**/ready.json
 
# --- SpeciesNet / kagglehub cache if it ever sits in the folder ---
kagglehub/
.cache/
 
# --- Build output ---
Output/
wildtag_dist/
*.zip
wildtag_Setup*.exe
wildtag_Setup*.bin
 
# --- Runtime / machine-specific state ---
wildtag_settings.json
wildtag_startup.log
wildtag_run_summary.txt
wildtag_run_stats.json
 
# --- Per-project working data (should never be in the app repo) ---
validation/
distribute/
collect/
favourites/
results.csv
results_with_ids.csv
 
# --- Python bytecode / caches ---
__pycache__/
*.pyc
*.pyo
 
# --- Editor / OS cruft ---
.Rproj.user/
.vscode/
.idea/
Thumbs.db
desktop.ini
*~
 
# --- Demo videos / large media (keep on disk, not in repo) ---
*.mp4
*.mov
*.avi
*.mkv
